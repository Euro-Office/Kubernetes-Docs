# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.helmignore
.git/
.github/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Test dirs
sources/litmus/
# Anchored: an unanchored tests/ would also drop templates/tests/ (the helm test hooks)
/tests/
sources/scripts/test_redis_rendering.py
sources/scripts/test_ds_tls.py
